# === Supabase (BẮT BUỘC khi deploy lên Vercel) ===
# Lấy ở Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dùng service_role key (chỉ chạy trên server, KHÔNG đặt tên bắt đầu bằng NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# === AI (TÙY CHỌN) ===
# Có key -> nút "Phân tích bằng Claude" xuất hiện. Không có key -> dùng thuật toán heuristic có sẵn.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
